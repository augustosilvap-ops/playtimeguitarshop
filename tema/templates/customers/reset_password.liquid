<section class="section section--light"><div class="container customer">
<h1 class="h2">Nova senha</h1>
{%- form 'reset_customer_password', class: 'form' -%}
  {{ form.errors | default_errors }}
  <div class="field"><label for="P1">Nova senha</label><input id="P1" type="password" name="customer[password]" required></div>
  <div class="field"><label for="P2">Confirme a senha</label><input id="P2" type="password" name="customer[password_confirmation]" required></div>
  <button class="btn btn--dark" type="submit">Salvar</button>
{%- endform -%}
</div></section>
