{%- layout none -%}
{%- liquid
  assign m = product.metafields.custom
  capture fields
    render 'spec-fields'
  endcapture
  assign rows = fields | newline_to_br | split: '<br />'
-%}
{
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "vendor": {{ product.vendor | json }},
  "type": {{ product.type | json }},
  "url": {{ product.url | json }},
  "price": {{ product.price | money | json }},
  "available": {{ product.available | json }},
  "image": {{ product.featured_media | image_url: width: 600 | json }},
  "specs": [
    {%- for r in rows -%}
      {%- assign kv = r | strip | split: '|' -%}
      {%- assign key = kv[0] -%}
      {%- assign val = m[key] | default: '' | strip_html -%}
      {"label": {{ kv[1] | json }}, "value": {{ val | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
