<section class="section">
  <div class="container tuner" data-tuner>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h2">{{ section.settings.heading }}</h1>
    <p class="lead" style="margin:0 auto">{{ section.settings.text }}</p>
    <div class="tuner__presets" role="group" aria-label="Afinação" style="margin-top:32px">
      <button type="button" data-preset="guitarra" aria-pressed="true">Guitarra/violão</button>
      <button type="button" data-preset="baixo" aria-pressed="false">Baixo 4 cordas</button>
      <button type="button" data-preset="dropd" aria-pressed="false">Drop D</button>
    </div>
    <div class="tuner__dial" aria-hidden="true">
      <svg viewBox="0 0 520 290">
        <defs><linearGradient id="arc" x1="0" x2="1"><stop offset="0" stop-color="#6e1212"/><stop offset=".42" stop-color="#eca700"/><stop offset=".5" stop-color="#f4efe6"/><stop offset=".58" stop-color="#eca700"/><stop offset="1" stop-color="#6e1212"/></linearGradient></defs>
        <path d="M40 270 A220 220 0 0 1 480 270" fill="none" stroke="url(#arc)" stroke-width="6" stroke-linecap="round"/>
        {%- for i in (0..20) -%}
          {%- assign deg = i | times: 9 | minus: 90 -%}
          {%- if deg == 0 -%}<line x1="260" y1="62" x2="260" y2="88" stroke="#eca700" stroke-width="3" transform="rotate(0 260 270)"/>
          {%- elsif deg == -45 or deg == 45 -%}<line x1="260" y1="62" x2="260" y2="80" stroke="rgba(244,239,230,.35)" stroke-width="1.5" transform="rotate({{ deg }} 260 270)"/>
          {%- else -%}<line x1="260" y1="62" x2="260" y2="74" stroke="rgba(244,239,230,.35)" stroke-width="1.5" transform="rotate({{ deg }} 260 270)"/>{%- endif -%}
        {%- endfor -%}
        <text x="40" y="290" fill="#c9bfb1" font-size="13" font-family="Montserrat" text-anchor="middle">−50</text>
        <text x="480" y="290" fill="#c9bfb1" font-size="13" font-family="Montserrat" text-anchor="middle">+50</text>
        <g class="tuner__needle"><line x1="260" y1="270" x2="260" y2="70" stroke="#f4efe6" stroke-width="3" stroke-linecap="round"/><circle cx="260" cy="270" r="9" fill="#eca700"/></g>
      </svg>
    </div>
    <div class="tuner__note" data-note aria-live="polite">–</div>
    <p class="tuner__freq" data-freq>Toque uma corda</p>
    <p class="tuner__status" data-status role="status"></p>
    <button class="btn btn--gold" type="button" data-start style="margin-top:16px">Ativar microfone</button>
    <p class="muted" style="font-size:.85rem;margin-top:12px">O áudio é analisado só no seu aparelho. Nada é gravado nem enviado.</p>
    <h2 class="h3" style="margin-top:56px">Nota de referência</h2>
    <p class="muted" style="margin:0">Toque no botão para ouvir a nota de cada corda.</p>
    <div class="tuner__strings"></div>
  </div>
</section>
<script src="{{ 'tuner.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Afinador",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Clínica Playtime" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Afinador online" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Funciona com o microfone do celular ou do computador. Afine em silêncio, uma corda por vez." }
  ],
  "presets": [{ "name": "Afinador" }]
}
{% endschema %}
