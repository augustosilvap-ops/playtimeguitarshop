<section class="section{% if section.settings.light %} section--light{% endif %}"><div class="container">
  <div class="section-head" data-reveal><div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
  </div></div>
  <ol class="promise">
    {%- for block in section.blocks -%}
      <li class="promise__item" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
        <span class="promise__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
        <h3>{{ block.settings.title }}</h3>
        <div class="rte">{{ block.settings.text }}</div>
      </li>
    {%- endfor -%}
  </ol>
</div></section>
{% schema %}
{
  "name": "Garantias em passos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Compra segura" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Chegou com avaria? A gente resolve." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "light", "label": "Fundo claro", "default": false }
  ],
  "blocks": [
    { "type": "step", "name": "Passo", "settings": [
      { "type": "select", "id": "icon", "label": "Ícone", "default": "box", "options": [
        { "value": "box", "label": "Caixa" }, { "value": "shield", "label": "Escudo" }, { "value": "video", "label": "Vídeo" }, { "value": "swap", "label": "Troca" },
        { "value": "check", "label": "Visto" }, { "value": "passport", "label": "Passaporte" }, { "value": "search", "label": "Lupa" }, { "value": "tools", "label": "Ferramenta" } ] },
      { "type": "text", "id": "title", "label": "Título", "default": "Passo" },
      { "type": "richtext", "id": "text", "label": "Texto" }
    ]}
  ],
  "presets": [{ "name": "Garantias em passos" }]
}
{% endschema %}
