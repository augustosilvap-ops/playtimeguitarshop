{%- liquid
  assign half = section.blocks.size | divided_by: 2
  if section.settings.rows == 1
    assign half = section.blocks.size
  endif
-%}
<section class="section brands" aria-label="{{ section.settings.heading | escape }}">
  <div class="container"><div class="section-head" data-reveal><div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
  </div></div></div>
  <div class="brands__rows">
    {%- for row in (1..section.settings.rows) -%}
      <div class="brands__row{% if row == 2 %} brands__row--rev{% endif %}" style="--speed: {{ section.settings.speed }}s">
        <div class="brands__track">
          {%- for pass in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign in_row = 1
                if section.settings.rows == 2 and forloop.index > half
                  assign in_row = 2
                endif
              -%}
              {%- if in_row == row -%}
                {%- capture href -%}{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- else -%}{{ routes.collections_url }}/vendors?q={{ block.settings.name | url_encode }}{%- endif -%}{%- endcapture -%}
                <a class="brand-tile" href="{{ href }}"{% if pass == 2 %} aria-hidden="true" tabindex="-1"{% endif %} {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: height: 112 | image_tag: alt: block.settings.name, loading: 'lazy' }}
                  {%- else -%}
                    <span class="brand-tile__name brand-tile__name--{{ block.settings.style }}">{{ block.settings.name }}</span>
                  {%- endif -%}
                  <span class="brand-tile__meta">Ver peças</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Logos das marcas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Marcas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "As marcas do nosso acervo" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "range", "id": "rows", "label": "Fileiras", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "speed", "label": "Duração de uma volta (segundos)", "min": 20, "max": 120, "step": 5, "default": 55 }
  ],
  "blocks": [
    { "type": "brand", "name": "Marca", "settings": [
      { "type": "text", "id": "name", "label": "Nome", "default": "Marca" },
      { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Use o logo oficial (PNG ou SVG com fundo transparente). Sem logo, mostramos o nome." },
      { "type": "select", "id": "style", "label": "Estilo do nome (quando não há logo)", "default": "serif", "options": [
        { "value": "serif", "label": "Serifa itálica" }, { "value": "sans", "label": "Caixa alta espaçada" }, { "value": "wide", "label": "Moderno" } ] },
      { "type": "url", "id": "link", "label": "Link", "info": "Se ficar vazio, abre todos os produtos da marca." }
    ]}
  ],
  "presets": [{ "name": "Logos das marcas", "blocks": [{ "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }] }]
}
{% endschema %}
