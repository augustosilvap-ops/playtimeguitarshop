{%- liquid
  assign first = section.settings.prefix | append: '0000.jpg'
  assign first_m = section.settings.prefix_mobile | append: '0000.jpg'
  if section.settings.source == 'theme'
    assign frames = first | asset_url
    assign frames_m = first_m | asset_url
  else
    assign frames = first | file_url
    assign frames_m = first_m | file_url
  endif
  assign poster = 'hero-poster.jpg' | asset_url
  if section.settings.poster != blank
    assign poster = section.settings.poster | image_url: width: 2000
  endif
-%}
<section class="scroll-hero" data-scroll-hero data-frames="{{ frames }}" data-count="{{ section.settings.count }}" data-frames-mobile="{{ frames_m }}" data-count-mobile="{{ section.settings.count_mobile }}" aria-label="Apresentação">
  <div class="scroll-hero__stage" style="background:#0f0b0a url('{{ poster }}') center/cover no-repeat">
    <canvas class="scroll-hero__canvas" aria-hidden="true"></canvas><div class="scroll-hero__shade"></div>
    <div class="scroll-hero__steps">
      {%- for block in section.blocks -%}
        <div class="scroll-hero__step{% if forloop.first %} is-active{% endif %}" data-layout="{{ block.settings.layout }}" data-scroll="{{ block.settings.scroll }}" {{ block.shopify_attributes }}>
          <div class="scroll-hero__copy">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if forloop.first -%}<h1 class="h-display">{{ block.settings.heading }}</h1>{%- else -%}<h2 class="h1">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="lead">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.btn1_label != blank or block.settings.btn2_label != blank -%}
              <div class="scroll-hero__ctas">
                {%- if block.settings.btn1_label != blank -%}<a class="btn btn--gold" href="{{ block.settings.btn1_link | default: routes.all_products_collection_url }}">{{ block.settings.btn1_label }}</a>{%- endif -%}
                {%- if block.settings.btn2_label != blank -%}<a class="btn btn--ghost" href="{{ block.settings.btn2_link | default: '#' }}">{{ block.settings.btn2_label }}</a>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="scroll-hero__progress" aria-hidden="true">{%- for block in section.blocks -%}<span></span>{%- endfor -%}</div>
    <div class="scroll-hero__hint" aria-hidden="true">Role</div>
  </div>
</section>
<script src="{{ 'scroll-hero.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Abertura com rolagem",
  "settings": [
    { "type": "select", "id": "source", "label": "Onde estão os quadros da animação", "default": "files", "options": [
      { "value": "files", "label": "Conteúdo › Arquivos (recomendado)" },
      { "value": "theme", "label": "Dentro do tema" } ],
      "info": "Envie os arquivos hero_0000.jpg … hero_0143.jpg e hero-m_0000.jpg … hero-m_0143.jpg em Conteúdo › Arquivos. Sem eles, a abertura mostra a imagem estática." },
    { "type": "image_picker", "id": "poster", "label": "Imagem estática (opcional)" },
    { "type": "text", "id": "prefix", "label": "Nome dos quadros (computador)", "default": "hero_" },
    { "type": "text", "id": "prefix_mobile", "label": "Nome dos quadros (celular)", "default": "hero-m_" },
    { "type": "number", "id": "count", "label": "Quadros (computador)", "default": 144 },
    { "type": "number", "id": "count_mobile", "label": "Quadros (celular)", "default": 144 }
  ],
  "blocks": [
    { "type": "step", "name": "Etapa", "settings": [
      { "type": "select", "id": "layout", "label": "Posição do texto", "default": "center", "options": [
        { "value": "center", "label": "Centro" }, { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }, { "value": "lower-third", "label": "Embaixo" } ] },
      { "type": "range", "id": "scroll", "label": "Duração na rolagem (px)", "min": 600, "max": 2400, "step": 100, "default": 1300 },
      { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
      { "type": "text", "id": "heading", "label": "Título", "default": "Instrumentos com história." },
      { "type": "textarea", "id": "text", "label": "Texto" },
      { "type": "text", "id": "btn1_label", "label": "Botão 1" },
      { "type": "url", "id": "btn1_link", "label": "Link do botão 1" },
      { "type": "text", "id": "btn2_label", "label": "Botão 2" },
      { "type": "url", "id": "btn2_link", "label": "Link do botão 2" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Abertura com rolagem", "blocks": [{ "type": "step" }] }]
}
{% endschema %}
