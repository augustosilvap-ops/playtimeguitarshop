<section class="section section--light" style="padding-top:48px"><div class="container" data-compare-page>
  <div class="section-head"><div>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
  </div></div>
  <div class="empty-state" data-compare-empty hidden>
    <p class="lead" style="margin:0 auto 24px">Escolha pelo menos duas peças. Na página de cada instrumento, toque em “Adicionar à comparação”.</p>
    <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}">Ver instrumentos</a>
  </div>
  <div data-compare-table></div>
</div></section>
{% schema %}
{
  "name": "Comparador",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Comparar" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lado a lado" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Até três peças, com as medidas que importam na mão: escala, braço, raio, peso." }
  ],
  "presets": [{ "name": "Comparador" }]
}
{% endschema %}
