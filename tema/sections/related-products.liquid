<section class="section"><div class="container">
  <div class="section-head"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div>
  {%- liquid
    assign c = product.collections.first
    if section.settings.collection != blank
      assign c = section.settings.collection
    endif
  -%}
  <div class="rail">
    {%- assign shown = 0 -%}
    {%- for p in c.products -%}
      {%- if p.id != product.id and p.available and shown < section.settings.limit -%}
        {% render 'product-card', product: p, delay: shown %}{%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Você também pode gostar",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Continue vendo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Você também pode gostar" },
    { "type": "collection", "id": "collection", "label": "Coleção (opcional)", "info": "Se ficar vazia, usamos a primeira coleção do produto." },
    { "type": "range", "id": "limit", "label": "Quantidade", "min": 2, "max": 12, "step": 1, "default": 6 }
  ]
}
{% endschema %}
