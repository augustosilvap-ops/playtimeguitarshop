<section class="section section--wine"><div class="container cta-row" data-reveal>
  <div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead" style="color:rgba(244,239,230,.82)">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="cta-row__btns">
    {%- if section.settings.btn1_label != blank -%}<a class="btn btn--gold" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
    {%- if section.settings.btn2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Chamada (vinho)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Troca com avaliação justa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Seu instrumento vale como entrada" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "btn1_label", "label": "Botão 1", "default": "Avaliar meu instrumento" },
    { "type": "url", "id": "btn1_link", "label": "Link do botão 1" },
    { "type": "text", "id": "btn2_label", "label": "Botão 2" },
    { "type": "url", "id": "btn2_link", "label": "Link do botão 2" }
  ],
  "presets": [{ "name": "Chamada (vinho)" }]
}
{% endschema %}
