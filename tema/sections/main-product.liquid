{%- liquid
  assign v = product.selected_or_first_available_variant
  assign m = product.metafields.custom
  assign c = collection | default: product.collections.first
-%}
<section class="section section--light" style="padding-top:48px"><div class="container">
  <nav aria-label="Você está em" class="muted crumbs"><a href="{{ routes.root_url }}">Início</a>{% if c %} / <a href="{{ c.url }}">{{ c.title }}</a>{% endif %} / <span aria-current="page">{{ product.title }}</span></nav>
  <div class="product">
    <div class="product__gallery">
      {%- for media in product.media -%}
        <div>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- if forloop.first -%}
                {{ media | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(max-width: 989px) 100vw, 56vw', alt: media.alt | default: product.title, fetchpriority: 'high' }}
              {%- else -%}
                {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(max-width: 599px) 88vw, (max-width: 989px) 50vw, 28vw', alt: media.alt | default: product.title }}
              {%- endif -%}
            {%- when 'video' -%}{{ media | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
            {%- when 'external_video' -%}{{ media | external_video_tag }}
            {%- else -%}{{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div><div class="ph ph--sq"><div class="ph__brand">{{ product.vendor }}</div></div></div>
      {%- endfor -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}><p class="product__brand" style="margin:0 0 8px">{{ product.vendor }}</p><h1 class="product__title">{{ product.title }}</h1></div>
          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>{% render 'price', product: product, variant: v, big: true %}</div>
          {%- when 'buy' -%}
            <div {{ block.shopify_attributes }}>
            {%- form 'product', product, class: 'product__buy', data-ajax-cart: '' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker"><label for="Variant-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
                  <select id="Variant-{{ section.id }}" name="id">
                    {%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant == v %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — esgotado{% endunless %}</option>{%- endfor -%}
                  </select></div>
              {%- else -%}
                <input type="hidden" name="id" value="{{ v.id }}">
              {%- endunless -%}
              {%- if product.available -%}
                <button class="btn btn--dark btn--block" type="submit">Adicionar ao carrinho</button>
                {{ form | payment_button }}
              {%- else -%}
                <button class="btn btn--dark btn--block" type="button" disabled>Vendido</button>
                {%- if settings.whatsapp != blank -%}<a class="btn btn--ghost btn--block" href="https://wa.me/{{ settings.whatsapp }}?text={{ 'Olá, Playtime! Tenho interesse em algo parecido com: ' | append: product.title | url_encode }}" target="_blank" rel="noopener">Quero algo parecido</a>{%- endif -%}
              {%- endif -%}
            {%- endform -%}
            </div>
          {%- when 'live' -%}
            {%- if settings.whatsapp != blank -%}
              <a class="live-card" href="https://wa.me/{{ settings.whatsapp }}?text={{ 'Olá, Playtime! Quero ver por vídeo a peça: ' | append: product.title | append: ' — ' | append: shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}><span class="live-card__dot" aria-hidden="true"></span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></a>
            {%- endif -%}
          {%- when 'passport' -%}
            <div {{ block.shopify_attributes }}>{% render 'passport', product: product %}</div>
          {%- when 'sound' -%}
            {%- if m.audio_limpo != blank or m.audio_drive != blank -%}
              <div class="sound-demo" data-sound-demo {{ block.shopify_attributes }}>
                <div class="sound-demo__head"><strong>{% render 'icon', name: 'headphones', size: 18 %} Ouça esta peça</strong><button type="button" class="btn btn--dark" style="min-height:40px;padding:0 18px" data-sound-play>Ouvir</button></div>
                <div class="sound-demo__tracks" role="group" aria-label="Escolha o timbre">
                  {%- if m.audio_limpo != blank -%}<button type="button" aria-pressed="true" data-src="{{ m.audio_limpo.value.url }}">Limpo</button>{%- endif -%}
                  {%- if m.audio_drive != blank -%}<button type="button" aria-pressed="false" data-src="{{ m.audio_drive.value.url }}">Com drive</button>{%- endif -%}
                </div>
                <div class="sound-demo__wave" aria-hidden="true">{%- for i in (1..48) -%}{%- assign h = i | times: 37 | modulo: 85 | plus: 20 -%}<i style="height:{{ h }}%"></i>{%- endfor -%}</div>
                <p class="field__help" data-sound-status style="margin:0">Gravado na Playtime com esta unidade, sem efeitos de pós-produção.</p>
              </div>
            {%- endif -%}
          {%- when 'services' -%}
            <ul class="service-list" {{ block.shopify_attributes }}>
              <li>{% render 'icon', name: 'tools' %}<span><strong>Regulado antes do envio.</strong> Nossa oficina ajusta altura das cordas, oitavas e tensor.</span></li>
              <li>{% render 'icon', name: 'box' %}<span><strong>Embalagem reforçada.</strong> Caixa dupla e proteção no headstock.</span></li>
              <li>{% render 'icon', name: 'swap' %}<span><strong>Seu usado como entrada.</strong> Pré-avaliação em um minuto na página Troca.</span></li>
              <li>{% render 'icon', name: 'check' %}<span><strong>7 dias para devolução.</strong> Direito de arrependimento garantido pelo CDC.</span></li>
            </ul>
          {%- when 'description' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              {%- if product.description != blank -%}<details open><summary>Descrição</summary><div class="rte">{{ product.description }}</div></details>{%- endif -%}
              <details><summary>Envio e embalagem</summary><div class="rte"><p>{{ block.settings.shipping }}</p></div></details>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Produto",
  "blocks": [
    { "type": "title", "name": "Marca e título", "limit": 1 },
    { "type": "price", "name": "Preço", "limit": 1 },
    { "type": "buy", "name": "Botão de compra", "limit": 1 },
    { "type": "live", "name": "Vitrine ao vivo", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Vitrine ao vivo" },
      { "type": "text", "id": "text", "label": "Texto", "default": "Veja esta peça por videochamada antes de comprar. A gente toca pra você." } ] },
    { "type": "passport", "name": "Passaporte", "limit": 1 },
    { "type": "sound", "name": "Ouça esta peça", "limit": 1 },
    { "type": "services", "name": "Serviços", "limit": 1 },
    { "type": "description", "name": "Descrição e envio", "limit": 1, "settings": [
      { "type": "textarea", "id": "shipping", "label": "Texto de envio", "default": "Enviamos para todo o Brasil com seguro. O prazo aparece no checkout pelo CEP." } ] }
  ]
}
{% endschema %}
