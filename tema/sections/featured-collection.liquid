{%- assign c = section.settings.collection -%}
<section class="section{% if section.settings.light %} section--light{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}><div class="container">
  <div class="section-head" data-reveal><div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  {%- if c != blank -%}<a class="link-arrow" href="{{ c.url }}">Ver todos {% render 'icon', name: 'arrow', size: 16 %}</a>{%- endif -%}
  </div>
  <div class="rail">
    {%- if c != blank -%}
      {%- for product in c.products limit: section.settings.limit -%}{% render 'product-card', product: product, delay: forloop.index0 %}{%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}<div class="product-card"><div class="product-card__media"><div class="ph"><div class="ph__brand">Escolha uma coleção</div></div></div><div class="product-card__body"><h3 class="product-card__title">Produto</h3></div></div>{%- endfor -%}
    {%- endif -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Vitrine de coleção",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "limit", "label": "Quantidade", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Vitrine" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Peças em destaque" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "light", "label": "Fundo claro", "default": true },
    { "type": "text", "id": "anchor", "label": "Âncora (id) opcional" }
  ],
  "presets": [{ "name": "Vitrine de coleção" }]
}
{% endschema %}
