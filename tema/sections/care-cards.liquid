<section class="section"><div class="container">
  <div class="section-head" data-reveal><div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2></div>
    {%- if section.settings.link_label != blank -%}<a class="link-arrow" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow', size: 16 %}</a>{%- endif -%}
  </div>
  <div class="grid grid--4">
    {%- for block in section.blocks -%}
      <a class="care-card" href="{{ block.settings.link | default: '#' }}" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 32 %}<h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="care-card__meta">{{ block.settings.meta }}</span></a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Cartões da Clínica",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Clínica Playtime" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Guias e ferramentas" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Ver todos os guias" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "card", "name": "Cartão", "settings": [
      { "type": "select", "id": "icon", "label": "Ícone", "default": "gauge", "options": [
        { "value": "gauge", "label": "Afinador" }, { "value": "strings", "label": "Cordas" }, { "value": "drop", "label": "Umidade" },
        { "value": "calendar", "label": "Calendário" }, { "value": "tools", "label": "Ferramenta" } ] },
      { "type": "text", "id": "title", "label": "Título", "default": "Afinador" },
      { "type": "text", "id": "text", "label": "Texto" },
      { "type": "text", "id": "meta", "label": "Rótulo", "default": "Ferramenta" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Cartões da Clínica" }]
}
{% endschema %}
