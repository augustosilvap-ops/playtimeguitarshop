<section class="section{% if section.settings.light %} section--light{% endif %}"><div class="container" style="max-width:860px">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="rte">{{ section.settings.text }}</div>
</div></section>
{% schema %}
{
  "name": "Texto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "light", "label": "Fundo claro", "default": true }
  ],
  "presets": [{ "name": "Texto" }]
}
{% endschema %}
