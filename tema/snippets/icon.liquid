{%- comment -%} Uso: {% render 'icon', name: 'tools', size: 20 %} {%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  case name
    when 'menu'
      assign p = '<path d="M4 7h16M4 12h16M4 17h16"/>'
    when 'close'
      assign p = '<path d="M6 6l12 12M18 6 6 18"/>'
    when 'search'
      assign p = '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>'
    when 'bag'
      assign p = '<path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/>'
    when 'user'
      assign p = '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>'
    when 'tools'
      assign p = '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6z"/>'
    when 'passport'
      assign p = '<rect x="5" y="3" width="14" height="18" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M9 16h6"/>'
    when 'card'
      assign p = '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/>'
    when 'swap'
      assign p = '<path d="M4 8h13l-3-3M20 16H7l3 3"/>'
    when 'arrow'
      assign p = '<path d="M5 12h14M13 6l6 6-6 6"/>'
    when 'weight'
      assign p = '<path d="M6 7h12l2 13H4L6 7z"/><circle cx="12" cy="5" r="2"/>'
    when 'wave'
      assign p = '<path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/>'
    when 'gauge'
      assign p = '<path d="M4 16a8 8 0 0 1 16 0"/><path d="m12 16 4-6"/><circle cx="12" cy="16" r="1.4"/>'
    when 'drop'
      assign p = '<path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/>'
    when 'strings'
      assign p = '<path d="M7 3v18M10 3v18M14 3v18M17 3v18"/><path d="M5 7h14"/>'
    when 'calendar'
      assign p = '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>'
    when 'shield'
      assign p = '<path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/>'
    when 'check'
      assign p = '<path d="m5 12 5 5 9-10"/>'
    when 'box'
      assign p = '<rect x="3" y="7" width="18" height="12" rx="2"/><path d="M9 7V5h6v2"/>'
    when 'ruler'
      assign p = '<path d="m3 17 14-14 4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>'
    when 'video'
      assign p = '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/>'
    when 'headphones'
      assign p = '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="7" rx="1.5"/><rect x="17" y="14" width="4" height="7" rx="1.5"/>'
    when 'star'
      assign p = '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" fill="currentColor"/>'
    when 'rotate'
      assign p = '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>'
  endcase
-%}
{%- if name == 'whatsapp' -%}
<svg class="icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
{%- else -%}
<svg class="icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ p }}</svg>
{%- endif -%}
